s eliminator winner\n","    if rand[2] < matchup_probs[(q1_loser, elim_winner)]:\n","        q2_winner = q1_loser\n","    else:\n","        q2_winner = elim_winner\n","\n","    finalist_count[q1_winner] += 1\n","    finalist_count[q2_winner] += 1\n","\n","    # final\n","    if rand[3] < matchup_probs[(q1_winner, q2_winner)]:\n","        champion = q1_winner\n","    else:\n","        champion = q2_winner\n","\n","    champion_count[champion] += 1\n","\n","print(f'\\nResults after {n_sims:,} simulations:')\n","print(f'{\"Team\":<35} {\"Final %\":>8} {\"Title %\":>8}')\n","for team in sorted(top4, key=lambda t: -champion_count[t]):\n","    fin_pct  = finalist_count[team] / n_sims\n","    champ_pct = champion_count[team] / n_sims\n","    print(f'{team:<35} {fin_pct:>8.1%} {champ_pct:>8.1%}')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zAOVZ75sqHG0","executionInfo":{"status":"ok","timestamp":1779839837709,"user_tz":240,"elapsed":501,"user":{"displayName":"Sahas Reddy","userId":"00007304376984259510"}},"outputId":"f55ec920-f3da-4c2d-c5a4-0e600f3bf302"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Playoff teams: ['RCB', 'GT', 'SRH', 'RR']\n","\n","Results after 50,000 simulations:\n","Team                                 Final %  Title %\n","Royal Challengers Bengaluru            86.4%    49.5%\n","Gujarat Titans                         94.3%    46.7%\n","Sunrisers Hyderabad                     6.5%     2.2%\n","Rajasthan Royals                       12.9%     1.6%\n"]}]},{"cell_type":"code","source":["# Create a mapping from abbreviation to color for consistent plotting\n","team_abbr_colors = {full_to_abbr[team_name]: color for team_name, color in team_colors.items()}\n","\n","champ_pcts = {full_to_abbr.get(t, t): champion_count[t] / n_sims for t in top4}\n","fin_pcts   = {full_to_abbr.get(t, t): finalist_count[t]  / n_sims for t in top4}\n","\n","fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n","\n","# Use t