"https://localhost:8080/","height":549},"id":"nzCyypbfgR-G","executionInfo":{"status":"ok","timestamp":1779836354340,"user_tz":240,"elapsed":308,"user":{"displayName":"Sahas Reddy","userId":"00007304376984259510"}},"outputId":"f236fb33-8407-4fcd-a274-b73cf3dbb04e"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 770x550 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":659},"id":"f88ec2ad","executionInfo":{"status":"ok","timestamp":1779836732543,"user_tz":240,"elapsed":693,"user":{"displayName":"Sahas Reddy","userId":"00007304376984259510"}},"outputId":"f120151a-9fcd-46b7-b585-693f0b32cf6c"},"source":["fig_economy_wickets, ax_economy_wickets = plt.subplots(figsize=(8, 6)) # Increased figure size\n","\n","for i, row in bowling_stats.iterrows():\n","    c = team_colors.get(row['team'], '#aaa')\n","    ax_economy_wickets.scatter(row['economy'], row['wickets'],\n","                    s=row['overs'] * 5, color=c, alpha=0.85, edgecolors='white', linewidth=0.5)\n","    # Adjusting annotation position to the right and center-aligned, with increased offset and smaller font\n","    ax_economy_wickets.annotate(row['bowler'].split()[-1],\n","                     (row['economy'] + 0.2, row['wickets']),\n","                     fontsize=6, ha='left', va='center') # Increased offset to 0.2\n","\n","ax_economy_wickets.set_xlabel('Economy Rate')\n","ax_economy_wickets.set_ylabel('Wickets')\n","ax_economy_wickets.set_title('Economy vs Wickets', fontweight='bold')\n","ax_economy_wickets.invert_xaxis()\n","\n","plt.tight_layout()\n","plt.savefig('/content/viz_economy_wickets.png', bbox_inches='tight')\n","plt.show()"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 880x660 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# figure out if batting first wins more often at each venue\n","hist_matches['bat_first_won'] = (\n","    ((hist_matches['toss_decision'] == 'bat')   & (hist_matches['toss_winner'] == hist_matches['winner'])) |\n","    ((hist_matches['toss_decision'] == 'field') & (hist_matches['toss_winner'] != hist_matches['winner']))\n",")\n","\n","# some venue names differ between datasets, normalize them\n","venue_fixes = {\n","    'M Chinnaswamy Stadium, Bengaluru':                          'M. Chinnaswamy Stadium, Bengaluru',\n","    'M Chinnaswamy Stadium':                                     'M. Chinnaswamy Stadium, Bengaluru',\n","    'Rajiv Gandhi International Stadium, Uppal, Hyderabad':      'Rajiv Gandhi International Stadium, Hyderabad',\n","    'MA Chidambaram Stadium, Chepauk, Chennai':                  'MA Chidambaram Stadium, Chennai',\n","    'Bharat Ratna Shri Atal Bihari Vajpayee Ekana Cricket Stadium, Lucknow': 'Ekana Cricket Stadium, Lucknow',\n","    'Himachal Pradesh Cricket Association Stadium, Dharamsala':  'HPCA Stadium, Dharamshala',\n","    'Punjab Cricket Association IS Bindra Stadium, Mohali':      'New PCA Cricket Stadium, Mullanpur',\n","    'Dr DY Patil Sports Academy, Mumbai':                        'Wankhede Stadium, Mumbai',\n","    'Brabourne Stadium, Mumbai':                                  'Wankhede Stadium, Mumbai',\n","}\n","hist_matches['venue'] = hist_matches['venue'].replace(venue_fixes)\n","\n","venue_stats = hist_matches.groupby('venue').agg(\n","    total=('id', 'count'),\n","    bat_first_wins=('bat_first_won', 'sum')\n",").reset_index()\n","\n","# only include venues with enough matches to be meaningful\n","venue_stats = venue_stats[venue_stats['total'] >= 8]\n","venue_stats['bat_first_win_rate'] = venue_stats['bat_first_wins'] / venue_stats['total']\n","venue_stats = venue_stats.sort_values('bat_first_win_rate', ascending=False)\n","\n","plt.figure(figsize=(11, 8)) # Increased figure height\n","bar_colors = []\n","for rate in venue_stats['bat_first_win_rate']:\n","    if rate > 0.5:\n","        bar_colors.append('#e74c3c')\n","    else:\n","        bar_colors.append('#3498db')\n","\n","plt.barh(venue_stats['venue'], venue_stats['bat_first_win_rate'], color=bar_colors)\n","plt.axvline(0.5, color='black', linestyle='--', linewidth=1.2, label='50% line')\n","plt.xlabel('Batting First Win Rate')\n","plt.title('Venue Pitch Bias (historical)', fontweight='bold')\n","plt.legend()\n","plt.tight_layout()\n","plt.savefig('/content/viz_venue.png', bbox_inches='tight')\n","plt.show()\n","\n","# save as a simple dict for later use\n","venue_bias = dict(zip(venue_stats['venue'], venue_stats['bat_first_win_rate']))\n","print(f'Venue data for {len(venue_bias)} grounds')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":690},"id":"_jedoEFBhAuD","executionInfo":{"status":"ok","timestamp":1779836464697,"user_tz":240,"elapsed":1005,"user":{"displayName":"Sahas Reddy","userId":"00007304376984259510"}},"outputId":"a12291b2-08eb-44e3-8098-32f32b8d6dac"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1210x880 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Venue data for 36 grounds\n"]}]},{"cell_type":"code","source":["# build a composite strength score from real 2026 data\n","# rather than hardcoding ratings\n","\n","pt = points_table.copy()\n","pt['win_rate'] = pt['wins'] / pt['matches']\n","\n","bat_by_team = batting_stats.groupby('team').agg(\n","    avg_sr=('strike_rate', 'mean'),\n","    avg_avg=('average', 'mean')\n",").reset_index()\n","\n","bowl_by_team = bowling_stats.groupby('team').agg(\n","    avg_econ=('economy', 'mean')\n",").reset_index()\n","\n","strength = pt[['team', 'win_rate', 'nrr']].copy()\n","strength = strength.merge(bat_by_team, on='team', how='left')\n","strength = strength.merge(bowl_by_team, on='team', how='left')\n","\n","# Exclude Chennai Super Kings as requested by the user\n","strength = strength[strength['team'] != 'Chennai Super Kings'].copy()\n","\n","# Fill NaN values in 'avg_sr', 'avg_avg', and 'avg_econ' with their respective means\n","# This ensures that all teams have a valid numerical value for these metrics\n","# even if they didn't appear in batting_stats or bowling_stats for 2026.\n","strength['avg_sr']   = strength['avg_sr'].fillna(strength['avg_sr'].mean())\n","strength['avg_avg']  = strength['avg_avg'].fillna(strength['avg_avg'].mean())\n","strength['avg_econ'] = strength['avg_econ'].fillna(strength['avg_econ'].mean())\n","\n","# normalize each column to 0-1 so they're on the same scale\n","def normalize(series):\n","    min_val = series.min()\n","    max_val = series.max()\n","    return (series - min_val) / (max_val - min_val + 0.0001)\n","\n","strength['score'] = (\n","    0.35 * normalize(strength['win_rate']) +\n","    0.20 * normalize(strength['nrr']) +\n","    0.20 * normalize(strength['avg_sr']) +\n","    0.15 * normalize(strength['avg_avg']) +\n","    0.10 * (1 - normalize(strength['avg_econ']))  # lower economy = better\n",") * 10\n","\n","team_strength = dict(zip(strength['team'], strength['score']))\n","nrr_map       = dict(zip(points_table['team'], points_table['nrr']))\n","\n","# plot it\n","s_sorted = strength.sort_values('score', ascending=False)\n","plt.figure(figsize=(10, 4))\n","bar_colors = [team_colors.get(t, '#aaa') for t in s_sorted['team'][::-1]]\n","plt.barh(s_sorted['team'][::-1], s_sorted['score'][::-1], color=bar_colors)\n","plt.xlabel('Strength Score (0-10)')\n","plt.title('Team Strength Index — based on 2026 stats', fontweight='bold')\n","for i, sc in enumerate(s_sorted['score'][::-1]):\n","    plt.text(sc + 0.05, i, f'{sc:.2f}', va='center', fontsize=9)\n","plt.tight_layout()\n","plt.savefig('/content/viz_strength.png', bbox_inches='tight')\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":371},"id":"Te_NYxA0hBsu","executionInfo":{"status":"ok","timestamp":1779838424425,"user_tz":240,"elapsed":268,"user":{"displayName":"Sahas Reddy","userId":"00007304376984259510"}},"outputId":"36745dec-7bbb-4383-bf4b-4b8ab5fdba1f"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1100x440 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# calculate historical h2h win rate for every team pair\n","h2h = {}\n","\n","for team_a in current_teams:\n","    for team_b in current_teams:\n","        if team_a == team_b:\n","            continue\n","\n","        games = hist_matches[\n","            ((hist_matches['team1'] == team_a) & (hist_matches['team2'] == team_b)) |\n","            ((hist_matches['team1'] == team_b) & (hist_matches['team2'] == team_a))\n","        ]\n","\n","        if len(games) == 0:\n","            h2h[(team_a, team_b)] = 0.5\n","            continue\n","\n","        wins = (games['winner'] == team_a).sum()\n","        h2h[(team_a, team_b)] = wins / len(games)\n","\n","print('H2H records calculated for', len(h2h), 'matchups')\n","print('Example — PBKS vs RCB:', round(h2h[('Punjab Kings', 'Royal Challengers Bengaluru')], 2))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"CdfTt5oVib-e","executionInfo":{"status":"ok","timestamp":1779838309705,"user_tz":240,"elapsed":118,"user":{"displayName":"Sahas Reddy","userId":"00007304376984259510"}},"outputId":"8176c69d-fe2b-43de-981b-257ad27ae3a7"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["H2H records calculated for 90 matchups\n","Example — PBKS vs RCB: 0.55\n"]}]},{"cell_type":"code","source":["df = hist_matches.copy()\n","\n","# target variable\n","df['team1_win'] = (df['team1'] == df['winner']).astype(int)\n","\n","# toss features\n","df['team1_won_toss']    = (df['team1'] == df['toss_winner']).astype(int)\n","df['toss_chose_bat']    = (df['toss_decision'] == 'bat').astype(int)\n","df['team1_batted_first'] = (\n","    ((df['team1_won_toss'] == 1) & (df['toss_chose_bat'